rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    function hasRole(role) {
      return 'roles' in request.auth.token && role in request.auth.token.roles;
    }
    // True for a provisioned council member: the account carries at least one role claim.
    function hasAnyRole() {
      return 'roles' in request.auth.token && request.auth.token.roles is list && request.auth.token.roles.size() > 0;
    }

    match /legislation/{legislation=**} {
      allow read: if true;
      // Only council leadership may edit legislation directly. The amendment-approval flow
      // writes legislation via the Admin SDK (which bypasses these rules), so it is unaffected.
      allow write: if isSignedIn() && (
        hasRole('Chairman') || hasRole('Speaker') || hasRole('DeputySpeaker') || hasRole('JudicialCommitteeChairman')
      );
    }

    match /documents/{docId} {
      function isPublished() {
        return 'published' in resource.data && resource.data.published == true;
      }
      function isAuthor() {
        return 'authorEmail' in resource.data && 'email' in request.auth.token && resource.data.authorEmail == request.auth.token.email;
      }
      function hasNoAuthor() {
        return !('authorEmail' in resource.data) || resource.data.authorEmail == null || resource.data.authorEmail == 'legacy';
      }
      function isPublic() {
        return resource.data.confidentiality == 'Public';
      }
      function isDeclassified() {
        return 'declassifyAt' in resource.data && resource.data.declassifyAt != null && request.time >= resource.data.declassifyAt;
      }
      // viewer tier by role (also gates confidential read)
      function isViewer() {
        return 'viewers' in resource.data && 'roles' in request.auth.token && resource.data.viewers.hasAny(request.auth.token.roles);
      }

      // --- collaborator tiers (each grantable by role or email) ---
      function isManagerByEmail() {
        return 'email' in request.auth.token && 'managerEmails' in resource.data && resource.data.managerEmails.hasAny([request.auth.token.email]);
      }
      function isManagerByRole() {
        return 'roles' in request.auth.token && 'managerRoles' in resource.data && resource.data.managerRoles.hasAny(request.auth.token.roles);
      }
      function isManager() {
        return isManagerByEmail() || isManagerByRole();
      }
      function isEditorByEmail() {
        return 'email' in request.auth.token && 'editorEmails' in resource.data && resource.data.editorEmails.hasAny([request.auth.token.email]);
      }
      function isEditorByRole() {
        return 'roles' in request.auth.token && 'editorRoles' in resource.data && resource.data.editorRoles.hasAny(request.auth.token.roles);
      }
      function isEditor() {
        return isManager() || isEditorByEmail() || isEditorByRole();
      }
      function isViewerByEmail() {
        return 'email' in request.auth.token && 'viewerEmails' in resource.data && resource.data.viewerEmails.hasAny([request.auth.token.email]);
      }
      function isViewerGrant() {
        return isEditor() || isViewerByEmail() || isViewer();
      }

      function canReadDocument() {
        return (isSignedIn() && isAuthor()) ||
               (hasNoAuthor() && isPublic()) ||
               (isPublished() && isPublic()) ||
               (isPublished() && (!isPublic()) && isSignedIn() && (isDeclassified() || isViewer()));
      }

      // An unowned (legacy) document predates per-document ownership. Only council leadership may
      // maintain one, and only one they can already read. Like any other non-owner, a steward can
      // neither claim it (ownerUnchanged) nor re-permission it (collaboratorListsUnchanged) in place.
      function isLegacySteward() {
        return hasNoAuthor()
          && (hasRole('Chairman') || hasRole('Speaker') || hasRole('DeputySpeaker') || hasRole('JudicialCommitteeChairman'))
          && (canReadDocument() || isViewerGrant());
      }

      // Only the owner may change authorEmail; only owner/managers may change the collaborator lists.
      function ownerUnchanged() {
        return request.resource.data.get('authorEmail', '') == resource.data.get('authorEmail', '');
      }
      function collaboratorListsUnchanged() {
        return request.resource.data.get('viewers', []) == resource.data.get('viewers', [])
          && request.resource.data.get('viewerEmails', []) == resource.data.get('viewerEmails', [])
          && request.resource.data.get('editorRoles', []) == resource.data.get('editorRoles', [])
          && request.resource.data.get('editorEmails', []) == resource.data.get('editorEmails', [])
          && request.resource.data.get('managerRoles', []) == resource.data.get('managerRoles', [])
          && request.resource.data.get('managerEmails', []) == resource.data.get('managerEmails', []);
      }
      // Editor identity cannot be forged (the history trigger trusts this field). Absence is tolerated.
      function lastEditedByValid() {
        return !('lastEditedBy' in request.resource.data)
          || (request.resource.data.lastEditedBy.email == request.auth.token.email
              && request.resource.data.lastEditedBy.uid == request.auth.uid);
      }

      allow read: if canReadDocument() || (isSignedIn() && isViewerGrant());
      // Only provisioned council members (accounts holding at least one role) may create documents,
      // the same test uploadAttachment applies. An account with no role cannot start a document.
      allow create: if isSignedIn()
        && hasAnyRole()
        && request.resource.data.authorEmail == request.auth.token.email
        && lastEditedByValid();
      allow update: if isSignedIn()
        && (isAuthor() || isLegacySteward() || isEditor())
        && (isAuthor() || ownerUnchanged())
        && (isAuthor() || isManager() || collaboratorListsUnchanged())
        && lastEditedByValid();
      allow delete: if isSignedIn() && (isAuthor() || isLegacySteward() || isManager());

      // Server-recorded edit history. Written ONLY by the recordDocumentHistory trigger
      // (Admin SDK bypasses rules); clients can read it if they may edit the parent doc.
      // They do that through the listDocumentHistory Cloud Function, never with a direct read. History is kept
      // when its parent is deleted or renamed (the audit trail), so a rule that judged access from whatever
      // document now sits at documents/{docId} would hand an earlier document's history to whoever re-creates
      // that ID. Telling the current document's entries from an earlier one's takes the parent's createTime,
      // which rules cannot read.
      match /history/{versionId} {
        allow read: if false;
        allow write: if false;
      }
    }

    // The only settings document a client reads is the notification mailing list (emails + roles), on the
    // /manage/accounts/mailing_list page, so only the council leadership may read it. Every other settings document
    // (settings/cache, the sitemap ID cache) is read and written by Cloud Functions through the Admin SDK, which
    // bypasses these rules, so clients get no read on it.
    match /settings/mailingList {
      allow read: if isSignedIn() && (
        hasRole('Chairman') || hasRole('Speaker') || hasRole('DeputySpeaker') || hasRole('JudicialCommitteeChairman')
      );
    }
    match /settings/{setting=**} {
      allow write: if isSignedIn() && ('Chairman' in request.auth.token.roles || 'Speaker' in request.auth.token.roles || 'DeputySpeaker' in request.auth.token.roles);
    }
    match /amendmentRequests/{requestId=**} {
      // A request holds the petitioner's name, email and UID plus the reviewers' in-progress decisions, so it is
      // readable only by the reviewers (AmendmentReviewPage, one document get). The petitioner never reads it back:
      // submitAmendmentRequest creates it through the Admin SDK. ElectoralCommitteeChairman is the approver for
      // VotingCommitteeOrder requests (functions/src/amendments.ts getApproverRoleForCategory).
      allow read: if isSignedIn() && (
        hasRole('Chairman') || hasRole('Speaker') || hasRole('DeputySpeaker') || hasRole('JudicialCommitteeChairman') || hasRole('ElectoralCommitteeChairman')
      );
      // A request is created, approved/rejected and deleted only by Cloud Functions (Admin SDK, which bypasses these rules). The one client write is the
      // approver's review page saving its in-progress state (reviewState, which includes the draft document that approval publishes), so only the role
      // resolveAmendmentRequest requires for the request's category may write it, and only that field. The writer must also hold one of the roles
      // that could write here before (Chairman, Speaker, DeputySpeaker, JudicialCommitteeChairman) or be ElectoralCommitteeChairman. ElectoralCommitteeChairman
      // is included on purpose, at the project owner's decision, so that the approver of VotingCommitteeOrder requests can save its review state; this is
      // the one place the write set is wider than before this patch. It gives that role no other write: isCategoryApprover() makes it the approver only
      // for VotingCommitteeOrder requests, so it still cannot write a request of any other category.
      // isCategoryApprover() holds the mapping from the stored categoryId to the approver role; keep it in step with getApproverRoleForCategory in
      // functions/src/amendments.ts. An unknown or missing category falls to Chairman, as it does there.
      function isCategoryApprover() {
        let category = resource.data.get('categoryId', '');
        return (category == 'StudentCouncilOrder' && hasRole('Speaker'))
          || (category == 'JudicialCommitteeOrder' && hasRole('JudicialCommitteeChairman'))
          || (category == 'VotingCommitteeOrder' && hasRole('ElectoralCommitteeChairman'))
          || (category != 'StudentCouncilOrder' && category != 'JudicialCommitteeOrder' && category != 'VotingCommitteeOrder' && hasRole('Chairman'));
      }
      allow update: if isSignedIn()
        && isCategoryApprover()
        && (hasRole('Chairman') || hasRole('Speaker') || hasRole('DeputySpeaker') || hasRole('JudicialCommitteeChairman') || hasRole('ElectoralCommitteeChairman'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewState']);
      allow create, delete: if false;
    }
  }
}

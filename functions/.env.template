# Description: This file contains the default values for the environment variables
#              that are used in the functions. This file is used as a template to
#              create the actual .env file that is used by the functions.
# This file should be copied to functions/.env and the values should be
# replaced with the actual values. The .env file should not be checked into the
# source control.

GMAIL_PASSWORD="" # get them here https://support.google.com/accounts/answer/185833
GMAIL_EMAIL="user@gmail.com" # replace with your email

# Sentry — for LOCAL runs only. On a real deploy the workflow appends SENTRY_DSN,
# SENTRY_ENVIRONMENT, SENTRY_RELEASE and SENTRY_TRACES_SAMPLE_RATE to functions/.env from
# the repo secret/variables, so they do NOT belong in the FUNCTIONS_ENV secret. An empty
# SENTRY_DSN turns reporting off: the wrappers in src/sentry.ts stay pass-throughs.
SENTRY_DSN="" # https://<org>.sentry.io/settings/projects/<project>/keys/
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0" # 0 = errors only, no performance data
